# Copy this file to .env and fill in your actual values.
# Never commit the .env file — it is gitignored.

# IBM Bob 2.0 Inference API key (required for live Assistant replies)
# Get it from: bob.ibm.com → subscription instance → API key management → New key → Inference
BOB_API_KEY=

# Bob API endpoint URL — copy from the same screen as your API key.
# Leave blank to use the default: https://bob.ibm.com/api/v1/chat/completions
BOB_API_URL=

# Bob model name — leave blank to use bob-2.0
BOB_MODEL=

# GitHub Personal Access Token (optional but recommended)
# Raises GitHub API rate limit from 60 → 5,000 requests/hr
# Create at: github.com/settings/tokens → Generate new token (classic) → no scopes needed
GITHUB_TOKEN=
